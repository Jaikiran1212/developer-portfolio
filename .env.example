# ==============================================================================
# JAI KIRAN PORTFOLIO - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS. Copy to .env.local for local development.
# In Vercel: Project Settings -> Environment Variables. Set them for BOTH
# "Production" AND "Preview" (otherwise preview deployments have no login - by design).
# ==============================================================================

# ---- REQUIRED --------------------------------------------------------------
SUPABASE_URL=https://xyzcompany.supabase.co
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key
# Comma-separated administrator e-mails (NO built-in default any more)
ADMIN_EMAILS=you@example.com
# Random secret used to hash visitor IPs (any long random string)
IP_HASH_SALT=change-me-to-a-long-random-string

# ---- STRONGLY RECOMMENDED --------------------------------------------------
# Shared rate limiting across serverless instances (free Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# New contact messages -> your inbox (Resend) and/or Telegram
RESEND_API_KEY=
RESEND_FROM=Portfolio <onboarding@resend.dev>
CONTACT_NOTIFY_EMAIL=you@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shown to visitors if saving a message fails
CONTACT_FALLBACK_EMAIL=you@example.com

# ---- OPTIONAL: Cloudflare Turnstile (bot protection on contact form + login) -
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ---- LOCAL DEVELOPMENT ONLY (ignored on Vercel; never set these in Vercel) ----
# Lets you use /admin without Supabase. Requires BOTH values below.
# ALLOW_DEV_AUTH=1
# DEV_ADMIN_PASSWORD=choose-a-local-password
