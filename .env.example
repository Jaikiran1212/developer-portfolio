# ==============================================================================
# JAI KIRAN PORTFOLIO - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# Copy this file to .env.local for local development.
# Configure these in your Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Supabase Public API URL (accessible by frontend & serverless functions)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co

# Supabase Anonymous Public Key (safe for browser client-side queries, protected by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND OR BROWSER)
# Required for privileged backend operations and admin role validations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role_key

# Comma-separated list of pre-authorized administrator emails
ADMIN_EMAILS=jaikiranjp@gmail.com

# Optional: Port for local development
PORT=3000
